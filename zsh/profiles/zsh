  cd $VIM_DIR
fi

# enhancd: only keep ~/workspace paths in the cd-history log.
# enhancd has no include/exclude option of its own: on cd into an unknown dir it
# runs `find -maxdepth 1` over every parent level and appends everything it sees,
# which floods the log with temp dirs, / and $HOME siblings, node_modules, etc.
# This after-cd hook (ENHANCD_HOOK_AFTER_CD) rewrites the log to an allowlist.
ENHANCD_INCLUDE_PATTERN="^${HOME}/workspace(/|$)"
ENHANCD_EXCLUDE_PATTERN='/(\.claude/worktrees|\.agents/skills|node_modules|\.git|\.next|\.venv|vendor|tmp|log|logs|coverage|dist|build|target)(/|$)'
__enhancd_prune_log() {
  local log="${ENHANCD_DIR:-$HOME/.enhancd}/enhancd.log"
  [[ -f $log ]] || return 0
  # Filter in-process (no grep/mv forks on every cd).
  local -a lines kept
  local line
  lines=(${(f)"$(<$log)"})
  for line in $lines; do
    [[ $line =~ $ENHANCD_INCLUDE_PATTERN && ! $line =~ $ENHANCD_EXCLUDE_PATTERN ]] && kept+=$line
  done
  # never leave the log empty: enhancd falls back to plain `cd` if it is
  (( $#kept )) || kept=("$HOME/workspace")
  # skip the write when nothing was pruned
  [[ ${(pj:\n:)kept} == ${(pj:\n:)lines} ]] || print -rl -- $kept >| "$log"
  return 0
}
ENHANCD_HOOK_AFTER_CD='__enhancd_prune_log'
